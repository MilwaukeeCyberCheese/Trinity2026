digraph G {

      node [
          fontname="Helvetica",
          fontsize=12,
          style="filled,rounded",
          color="#3b3b3b",
          penwidth=1.4,
          margin="0.16,0.10"
      ]

      edge [
          fontname="Helvetica",
          fontsize=10,
          color="#6b7280",
          penwidth=1.2,
          arrowsize=0.8,
          labeldistance=1.8
      ]

      "Center Start" [
          shape=box,
          fillcolor="#b8d8ba",
          color="#40634a",
          fontcolor="#1f2a21",
          penwidth=2
      ]

      center_sweep_neutral [
          shape=diamond,
          label="Sweep neutral\nzone?",
          fillcolor="#f6d98c",
          color="#9a6b00",
          fontcolor="#3b2a00"
      ]

      center_push_fuel [
          shape=diamond,
          label="Need to push Fuel\nto human players?",
          fillcolor="#f6d98c",
          color="#9a6b00",
          fontcolor="#3b2a00"
      ]

      "CenterShootCenter" [
          shape=box,
          fillcolor="#bcd4f6",
          color="#3c5f91",
          fontcolor="#16263d"
      ]

      "SweepAroundLeft" [
          shape=box,
          fillcolor="#bcd4f6",
          color="#3c5f91",
          fontcolor="#16263d"
      ]

      "SweepAroundRight" [
          shape=box,
          fillcolor="#bcd4f6",
          color="#3c5f91",
          fontcolor="#16263d"
      ]

      "LeftInShoot" [
          shape=box,
          fillcolor="#bcd4f6",
          color="#3c5f91",
          fontcolor="#16263d"
      ]

      "RightInShoot" [
          shape=box,
          fillcolor="#bcd4f6",
          color="#3c5f91",
          fontcolor="#16263d"
      ]

      "Stop" [
          shape=box,
          style="filled,rounded",
          fillcolor="#efb0b0",
          color="#9b3d3d",
          fontcolor="#4a1515"
      ]

      "Center Start" -> "CenterShootCenter"
      "CenterShootCenter" -> center_sweep_neutral
      center_sweep_neutral -> "Stop" [label="No"]
      center_sweep_neutral -> center_push_fuel [label="Yes"]

      center_push_fuel -> "SweepAroundRight" [label="Yes"]
      center_push_fuel -> "SweepAroundLeft" [label="No"]
      "SweepAroundLeft" -> "Stop" [label="Stop"]
      "SweepAroundLeft" -> "RightInShoot" [label="Continue"]
      "SweepAroundRight" -> "Stop" [label="Stop"]
      "SweepAroundRight" -> "LeftInShoot" [label="Continue"]
      "LeftInShoot" -> "Stop"
      "RightInShoot" -> "Stop"
  }
